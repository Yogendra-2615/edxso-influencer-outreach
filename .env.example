@'
# --- Data source (YouTube Data API v3, free key from Google Cloud Console) ---
YOUTUBE_API_KEY=
# --- LLM personalization ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# --- Your brand (used in the pitch) ---
BRAND_NAME=YourBrand
BRAND_PRODUCT=vegan skincare range
SENDER_NAME=Your Name
SENDER_TITLE=Partnerships, YourBrand
# --- Sending (DRY_RUN=true simulates; set false only for a real send) ---
DRY_RUN=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# --- Optional filter overrides ---
# TARGET_COUNTRIES=IN,US
# MIN_ENGAGEMENT=2.0
'@ | Set-Content -Encoding utf8 .env.example